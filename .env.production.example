# ==============================================================================
# FerreMax SaaS - Variables de Entorno para Producción en VPS
# Copia este archivo a ".env" antes de iniciar: cp .env.production.example .env
# ==============================================================================

# 1. DOMINIO WEB Y SSL AUTOMÁTICO (Caddy Let's Encrypt)
# Si ya tienes dominio registrado, colócalo aquí (ej: ferreteria.com o pos.miempresa.com).
# Caddy obtendrá e instalará el certificado SSL (HTTPS) de forma 100% automática y gratuita.
# Si todavía NO tienes dominio y vas a probar usando solo la IP del VPS, déjalo en :80
DOMAIN_NAME=:80

# 2. SEGURIDAD Y TOKEN JWT
# Clave criptográfica para firmar sesiones de cajeros y administradores.
# Puedes generar una clave aleatoria segura ejecutando en Linux: openssl rand -hex 32
JWT_SECRET=cambiar_esta_clave_por_una_cadena_secreta_muy_larga_2026

# 3. IDENTIDAD DEL NEGOCIO / EMPRESA (Aparecerá en Facturas y Cierres Z)
STORE_NAME="FerreMax Venezuela"
STORE_RIF="J-50123456-7"
STORE_ADDRESS="Av. Francisco de Miranda, Caracas, Venezuela"
STORE_PHONE="0212-9876543 / 0414-2345678"

# 4. PARÁMETROS FISCALES Y DE TASA BCV
BCV_DEFAULT_RATE=50.0
IVA_PERCENT=16
IGTF_PERCENT=3

# 5. INTELIGENCIA ARTIFICIAL (Opcional - Google Gemini)
# Clave gratuita obtenida en https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
